# ReliefHub environment configuration
# Copy this file to ".env" and fill in your Firebase project credentials.
# The app runs fully without Firebase (local repository mode) when these are empty.

# Firebase (Web app config from Firebase Console > Project settings)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Local administrator passcode (DEMO MODE ONLY).
# Used when Firebase is not configured. Change this before any real deployment.
VITE_LOCAL_ADMIN_PASSCODE=admin123
